# Local MongoDB (matches docker-compose.yml):
MONGODB_URI=mongodb://127.0.0.1:27017/oracle_ledger

# Or MongoDB Atlas (replace every <placeholder>, no angle brackets left in):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/oracle_ledger?retryWrites=true&w=majority

PORT=3000

# Browser origin allowed to call the API (Vite's default development URL).
FRONTEND_ORIGIN=http://localhost:5173
